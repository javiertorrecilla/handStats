# MongoDB
MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net/handstats

# Resend (Servicio de correo profesional HandStats Pro)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=HandStats Pro <no-reply@tudominio.com>
RESEND_REPLY_TO=soporte@tudominio.com

# Firebase Admin Service Account (para enlaces oficiales de verificación y recuperación)
FIREBASE_PROJECT_ID=handstats-ac5fa
# Opción A: JSON completo en una línea o codificado en Base64
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"handstats-ac5fa",...}
# Opción B (alternativa): usar client_email + private_key por separado
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@handstats-ac5fa.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# URL pública de HandStats (usada para enlaces de acción, logos y validación de origen)
APP_PUBLIC_URL=https://hand-stats.vercel.app

