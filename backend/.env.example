# MongoDB
MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net/handstats

# ==========================================================
# SERVICIO DE CORREO INDEPENDIENTE (elige Resend O Gmail/SMTP)
# ==========================================================

# Opción A: Gmail / SMTP estándar (muy rápido: solo correo + contraseña de aplicación)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=abcd_efgh_ijkl_mnop
# SMTP_FROM_EMAIL=Handtix Pro <tu_correo@gmail.com>

# Opción B: Resend API (recomendado en producción con dominio propio)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Handtix Pro <no-reply@tudominio.com>
# RESEND_REPLY_TO=soporte@tudominio.com

# Secreto para firmar tokens de sesión (recomendado fijar uno estable en Vercel)
# AUTH_TOKEN_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# URL pública de Handtix (usada en enlaces, logo del email y validación de origen)
APP_PUBLIC_URL=https://hand-stats.vercel.app
