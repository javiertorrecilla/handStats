# Plantilla de variables de entorno para Handtix Frontend (Vite)
# Copia este archivo como `.env` para desarrollo local y define estas variables en Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Telemetría de errores externa (Sentry). Si se deja vacío, los errores siguen enviándose al endpoint propio /api/telemetry/errors y Firebase.
VITE_SENTRY_DSN=

# URL de backend opcional (por defecto http://localhost:8000 en dev y /api en producción)
VITE_API_BASE_URL=

